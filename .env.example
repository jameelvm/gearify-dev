# Environment Variables for Local Development
# Copy this file to .env and update values as needed
# NEVER commit .env to source control!

# AWS Credentials (for LocalStack only)
# In production, use IAM roles instead
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# AWS Region
AWS__Region=us-east-1

# AWS Service Endpoints (LocalStack)
AWS__DynamoDB__ServiceURL=http://localhost:4566
AWS__S3__ServiceURL=http://localhost:4566
AWS__SNS__ServiceURL=http://localhost:4566
AWS__SQS__ServiceURL=http://localhost:4566
AWS__SecretsManager__ServiceURL=http://localhost:4566

# Observability
SEQ_URL=http://localhost:5341
OTLP_ENDPOINT=http://localhost:4318

# Redis
REDIS_URL=localhost:6379

# Database (if using external DB instead of DynamoDB)
# DATABASE_CONNECTION_STRING=Server=localhost;Database=gearify;User=sa;Password=YourStrong!Password

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# JWT Settings (example)
# JWT__SecretKey=your-secret-key-for-development-only
# JWT__Issuer=gearify-local
# JWT__Audience=gearify-local

# CORS Origins (comma-separated)
# CORS__AllowedOrigins=http://localhost:3000,http://localhost:4200
