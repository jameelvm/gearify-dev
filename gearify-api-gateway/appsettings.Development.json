{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog-destination": {
            "Address": "http://host.docker.internal:5001"
          }
        },
        "HttpRequest": {
          "Timeout": "00:10:00",
          "Version": "2",
          "VersionPolicy": "RequestVersionOrLower"
        }
      },
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://host.docker.internal:5011"
          }
        },
        "HttpRequest": {
          "Timeout": "00:10:00",
          "Version": "2",
          "VersionPolicy": "RequestVersionOrLower"
        }
      },
      "media-cluster": {
        "Destinations": {
          "media-destination": {
            "Address": "http://host.docker.internal:5009"
          }
        },
        "HttpRequest": {
          "Timeout": "00:10:00",
          "Version": "2",
          "VersionPolicy": "RequestVersionOrLower"
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-destination": {
            "Address": "http://host.docker.internal:5010"
          }
        },
        "HttpRequest": {
          "Timeout": "00:10:00",
          "Version": "2",
          "VersionPolicy": "RequestVersionOrLower"
        }
      },
      "search-cluster": {
        "Destinations": {
          "search-destination": {
            "Address": "http://host.docker.internal:5012"
          }
        },
        "HttpRequest": {
          "Timeout": "00:10:00",
          "Version": "2",
          "VersionPolicy": "RequestVersionOrLower"
        }
      },
      "cart-cluster": {
        "Destinations": {
          "cart-destination": {
            "Address": "http://host.docker.internal:5013"
          }
        },
        "HttpRequest": {
          "Timeout": "00:10:00",
          "Version": "2",
          "VersionPolicy": "RequestVersionOrLower"
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-destination": {
            "Address": "http://host.docker.internal:5014"
          }
        },
        "HttpRequest": {
          "Timeout": "00:10:00",
          "Version": "2",
          "VersionPolicy": "RequestVersionOrLower"
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-destination": {
            "Address": "http://host.docker.internal:5015"
          }
        },
        "HttpRequest": {
          "Timeout": "00:10:00",
          "Version": "2",
          "VersionPolicy": "RequestVersionOrLower"
        }
      },
      "shipping-cluster": {
        "Destinations": {
          "shipping-destination": {
            "Address": "http://host.docker.internal:5016"
          }
        },
        "HttpRequest": {
          "Timeout": "00:10:00",
          "Version": "2",
          "VersionPolicy": "RequestVersionOrLower"
        }
      }
    }
  },
  "Kestrel": {
    "Limits": {
      "KeepAliveTimeout": "00:10:00",
      "RequestHeadersTimeout": "00:10:00"
    }
  },
  "JwtSettings": {
    "Secret": "your-super-secret-jwt-key-that-is-at-least-32-characters-long-for-security",
    "Issuer": "gearify-auth",
    "Audience": "gearify-api"
  },
  "RateLimiting": {
    "PermitLimit": 1000,
    "Window": 60
  },
  "SEQ_URL": "http://localhost:5341",
  "OTLP_ENDPOINT": "http://localhost:4318"
}
