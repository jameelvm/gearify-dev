{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog-destination": {
            "Address": "http://host.docker.internal:5001"
          }
        },
        "HttpRequest": {
          "Timeout": "00:10:00",
          "Version": "2",
          "VersionPolicy": "RequestVersionOrLower"
        }
      },
      "media-cluster": {
        "Destinations": {
          "media-destination": {
            "Address": "http://host.docker.internal:6007"
          }
        },
        "HttpRequest": {
          "Timeout": "00:10:00",
          "Version": "2",
          "VersionPolicy": "RequestVersionOrLower"
        }
      }
    }
  },
  "Kestrel": {
    "Limits": {
      "KeepAliveTimeout": "00:10:00",
      "RequestHeadersTimeout": "00:10:00"
    }
  },
  "JwtSettings": {
    "Secret": "your-super-secret-jwt-key-that-is-at-least-32-characters-long-for-security",
    "Issuer": "gearify-auth",
    "Audience": "gearify-api"
  },
  "RateLimiting": {
    "PermitLimit": 1000,
    "Window": 60
  },
  "SEQ_URL": "http://localhost:5341",
  "OTLP_ENDPOINT": "http://localhost:4318"
}
