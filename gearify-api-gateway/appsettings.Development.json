{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://host.docker.internal:5011"
          }
        }
      }
    }
  },
  "Cognito": {
    "Authority": "https://cognito-idp.us-east-1.amazonaws.com",
    "UserPoolId": "us-east-1_example",
    "Region": "us-east-1"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": 60
  },
  "SEQ_URL": "http://localhost:5341",
  "OTLP_ENDPOINT": "http://localhost:4318"
}
