{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "password-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/password/{**catch-all}"
        }
      },
      "user-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/user/{**catch-all}"
        }
      },
      "address-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/address/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      "recommendations-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/recommendations/{**catch-all}"
        }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        }
      },
      "search-route": {
        "ClusterId": "search-cluster",
        "Match": {
          "Path": "/api/search/{**catch-all}"
        }
      },
      "checkout-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/checkout/{**catch-all}"
        }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "shipping-route": {
        "ClusterId": "shipping-cluster",
        "Match": {
          "Path": "/api/shipping/{**catch-all}"
        }
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }
      },
      "tenant-route": {
        "ClusterId": "tenant-cluster",
        "Match": {
          "Path": "/api/tenants/{**catch-all}"
        }
      },
      "media-route": {
        "ClusterId": "media-cluster",
        "Match": {
          "Path": "/api/media/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://auth-svc:80"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-destination": {
            "Address": "http://catalog-svc:80"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "cart-destination": {
            "Address": "http://cart-svc:80"
          }
        }
      },
      "search-cluster": {
        "Destinations": {
          "search-destination": {
            "Address": "http://search-svc:80"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-destination": {
            "Address": "http://order-svc:80"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-destination": {
            "Address": "http://payment-svc:80"
          }
        }
      },
      "shipping-cluster": {
        "Destinations": {
          "shipping-destination": {
            "Address": "http://shipping-svc:80"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory-destination": {
            "Address": "http://inventory-svc:80"
          }
        }
      },
      "tenant-cluster": {
        "Destinations": {
          "tenant-destination": {
            "Address": "http://tenant-svc:80"
          }
        }
      },
      "media-cluster": {
        "Destinations": {
          "media-destination": {
            "Address": "http://media-svc:80"
          }
        }
      }
    }
  },
  "JwtSettings": {
    "Secret": "your-super-secret-jwt-key-that-is-at-least-32-characters-long-for-security",
    "Issuer": "gearify-auth",
    "Audience": "gearify-api"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": 60
  },
  "AI": {
    "Region": "us-east-1",
    "UseLocalStack": true,
    "LocalStackEndpoint": "http://localhost:4566",
    "UserEventsQueueUrl": "http://localhost:4566/000000000000/gearify-user-events-queue",
    "UserEventsTableName": "gearify-user-events"
  }
}
