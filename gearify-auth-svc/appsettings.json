{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "your-super-secret-jwt-key-that-is-at-least-32-characters-long-for-security",
    "Issuer": "gearify-auth",
    "Audience": "gearify-api",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "LocalStack": {
    "UseLocalStack": false,
    "Session": {
      "AwsAccessKeyId": "test",
      "AwsAccessKey": "test",
      "AwsSecretAccessKey": "test"
    },
    "Config": {
      "LocalStackHost": "localhost:4566"
    }
  },
  "AWS": {
    "Profile": "default",
    "Region": "us-east-1"
  },
  "NotificationService": {
    "BaseUrl": "http://notification-svc:80"
  },
  "WebAppUrl": "http://localhost:4200",
  "Security": {
    "PasswordPolicy": {
      "MinimumLength": 8,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireSpecialChar": true,
      "PasswordHistoryCount": 5
    },
    "AccountLockout": {
      "MaxFailedAttempts": 5,
      "LockoutDurationMinutes": 30,
      "EnableLockout": true
    },
    "Mfa": {
      "CodeExpiryMinutes": 5,
      "MaxVerificationAttempts": 3,
      "BackupCodesCount": 10,
      "TotpIssuer": "Gearify",
      "TotpDigits": 6,
      "TotpPeriod": 30
    },
    "PasswordReset": {
      "TokenExpiryHours": 1,
      "MaxResetAttemptsPerDay": 3
    },
    "Session": {
      "MaxConcurrentSessions": 5,
      "SessionTimeoutMinutes": 60,
      "RefreshTokenExpiryDays": 1,
      "RefreshTokenExpiryDaysRememberMe": 7
    }
  },
  "Sms": {
    "Provider": "AWS_SNS",
    "FromNumber": "+1234567890",
    "AwsRegion": "us-east-1"
  },
  "StorageConfiguration": {
    "DynamoDb": {
      "UsersTableName": "gearify-users",
      "SessionsTableName": "UserSessions"
    }
  }
}
