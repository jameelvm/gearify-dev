{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LocalStack": {
    "UseLocalStack": true,
    "Session": {
      "AwsAccessKeyId": "test",
      "AwsAccessKey": "test",
      "AwsSecretAccessKey": "test"
    },
    "Config": {
      "LocalStackHost": "localhost:4566"
    }
  },
  "AWS": {
    "Profile": "default",
    "Region": "us-east-1"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "gearify-cart:"
  },
  "CatalogService": {
    "BaseUrl": "http://localhost:5001"
  },
  "CartConfiguration": {
    "DefaultExpirationDays": 30,
    "GuestCartExpirationDays": 7,
    "MaxItemsPerCart": 50,
    "MaxQuantityPerItem": 99
  }
}
