{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LocalStack": {
    "UseLocalStack": true,
    "Session": {
      "AwsAccessKeyId": "test",
      "AwsAccessKey": "test",
      "AwsSecretAccessKey": "test"
    },
    "Config": {
      "LocalStackHost": "localhost:4566"
    }
  },
  "AWS": {
    "Profile": "default",
    "Region": "us-east-1"
  },
  "ProductImageUploadConfiguration": {
    "MaxFileSizeBytes": 10485760,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/jpg",
      "image/png",
      "image/webp"
    ]
  },
  "StorageConfiguration": {
    "DynamoDb": {
      "CatalogTableName": "gearify-catalog",
      "ProductsTableName": "gearify-products",
      "BrandsTableName": "gearify-brands",
      "PriceRangesTableName": "gearify-price-ranges"
    }
  },
  "MessagingConfiguration": {
    "SQS": {
      "ProductThumbnailUpdateQueueUrl": "http://localhost:4566/000000000000/gearify-product-thumbnail-update-queue"
    },
    "SNS": {
      "CatalogEventsTopicArn": "arn:aws:sns:us-east-1:000000000000:catalog-events-topic"
    }
  },
  "MediaService": {
    "BaseUrl": "http://localhost:5009"
  },
  "SeedData": {
    "Enabled": true
  }
}
