{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LocalStack": {
    "UseLocalStack": true,
    "Session": {
      "AwsAccessKeyId": "test",
      "AwsAccessKey": "test",
      "AwsSecretAccessKey": "test"
    },
    "Config": {
      "LocalStackHost": "localhost:4566"
    }
  },
  "AWS": {
    "Profile": "default",
    "Region": "us-east-1"
  },
  "DatabaseConfiguration": {
    "ConnectionString": "Host=localhost;Port=5432;Database=gearify_orders;Username=postgres;Password=postgres"
  },
  "MessagingConfiguration": {
    "SNS": {
      "OrderEventsTopicArn": "arn:aws:sns:us-east-1:000000000000:gearify-order-events"
    },
    "SQS": {
      "PaymentCompletedQueueUrl": "http://localhost:4566/000000000000/gearify-payment-completed-queue",
      "PaymentFailedQueueUrl": "http://localhost:4566/000000000000/gearify-payment-failed-queue",
      "RefundCompletedQueueUrl": "http://localhost:4566/000000000000/gearify-refund-completed-queue",
      "PollingIntervalSeconds": 5,
      "MaxNumberOfMessages": 10
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
