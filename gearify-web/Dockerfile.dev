FROM node:20-alpine

WORKDIR /app

# Copy package files first for better layer caching
COPY package*.json ./

# Install dependencies
# Use npm install instead of npm ci if package-lock.json doesn't exist
RUN npm install

# Copy the rest of the application
# Note: In dev mode with volumes, this gets overridden by the volume mount
COPY . .

# Expose Angular dev server port
EXPOSE 4200

# Start dev server with hot reload
# --host 0.0.0.0: Allow external connections from host
# --disable-host-check: Prevent invalid host header errors
# --poll: Enable file watching in Docker (required for Windows/Mac)
CMD ["npm", "start"]
